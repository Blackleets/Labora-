# Labora+ — public client env (Vite). Never put service-role or Stripe secret keys here.
# Copy to .env.local and fill. Do not commit .env.local.

# ─── Required (Supabase anon — public by design) ─────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Billing (Labora+ Pro) — KEEP FALSE until Stripe sandbox UAT ─────────────
# Default must stay false. BillingCard is hidden while this is not exactly "true".
# Enable only after Lewis configures Edge Function secrets + sandbox checkout UAT.
VITE_BILLING_ENABLED=false

# Optional display-only labels (real prices live in Stripe Price IDs on the server).
# VITE_LABORA_PRO_MONTHLY_LABEL=9,99 €/mes
# VITE_LABORA_PRO_ANNUAL_LABEL=89,90 €/año

# ─── Edge Function secrets (Supabase Dashboard → Functions → Secrets) ────────
# These are SERVER-ONLY. Never prefix with VITE_. Lewis supplies after sandbox prep.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# LABORA_APP_URL=https://your-app.example
# LABORA_ALLOWED_ORIGINS=https://your-app.example,capacitor://localhost
# GEMINI_API_KEY=          # or GOOGLE_API_KEY — server only for labora-ai / OCR
#
# See BILLING_SETUP.md. Do not ask the bot for live keys; do not enable live billing here.
