# Labora+ — public client env (Vite). Never put service-role or Stripe secret keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Keep false until Stripe sandbox checkout + webhook + portal UAT passes.
VITE_BILLING_ENABLED=false

# Optional display-only labels (real prices live in Stripe Price IDs on the server).
# VITE_LABORA_PRO_MONTHLY_LABEL=9,99 €/mes
# VITE_LABORA_PRO_ANNUAL_LABEL=89,90 €/año

# Edge Function secrets (Supabase Dashboard → Functions → Secrets) — NOT VITE_*:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# LABORA_APP_URL=https://your-app.example
# GEMINI_API_KEY=   # or GOOGLE_API_KEY — server only for labora-ai
