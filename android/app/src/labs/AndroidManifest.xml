<?xml version="1.0" encoding="utf-8"?>
<!-- Solo flavour «labs» (fuera de Play). El flavour «play» NO declara este servicio. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- OPT-IN, deshabilitado por defecto: se habilita solo tras el consentimiento del rider. -->
        <service
            android:name="app.labora.plus.bubble.OrderNotificationListener"
            android:enabled="false"
            android:exported="true"
            android:label="Labora+ Labs · borrador de pedidos"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
